# App_Settings for the backend. Copy this file to .env; the values below start the app locally.
# Paths are relative to backend/, the working directory both in dev mode and in the container.

# Required. Tax Authority usage value dataset CSV (windows-1255).
DATASET_PATH=../data/usage-values-2026.csv

# Required. Tax year of the dataset that the app imports and searches.
TAX_YEAR=2026

# Required. SQL Server host; compose sets it to db. In dev mode use 127.0.0.1, not localhost (IPv6).
DB_HOST=127.0.0.1

# Required. SQL Server port.
DB_PORT=1433

# Required. Database name (letters, digits and underscores), created at startup if missing.
DB_NAME=car_advisor

# Required. SQL Server login; the local db container provides only sa.
DB_USER=sa

# Required. Password of DB_USER, also set as the sa password of the db container. Local-only sample.
DB_PASSWORD=LocalDev-Only-2026

# Required. Language model provider of the advisor bot.
LLM_PROVIDER=openai

# Required. Language model name at LLM_PROVIDER.
LLM_MODEL=gpt-6-luna

# Optional. OpenAI API key; when empty, the app starts without the advisor bot.
OPENAI_API_KEY=

# Required. Rules configuration file (rules.yaml).
RULES_PATH=../config/rules.yaml

# Required. Car catalog file (the challenge's data; replace it with Strauss's catalog).
CATALOG_PATH=../config/car_catalog.yaml

# Required. Occupations table file (the challenge's data; replace it with Strauss's table).
OCCUPATIONS_PATH=../config/occupations.yaml
